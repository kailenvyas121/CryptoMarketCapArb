# Optional. The app runs without any of these.

# Hosting platforms inject this. Local default is 5000.
# PORT=5050

# Raises CoinGecko rate limits. Public tier works without it.
# COINGECKO_API_KEY=

# Enables the Gemini-powered research chat. Falls back to a rule-based analyst if unset.
# GEMINI_API_KEY=

# Only needed if you wire up the optional Postgres persistence layer.
# DATABASE_URL=
